---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuizWidget from '../../components/QuizWidget.astro';
---

<BaseLayout title="Quiz" description="Test your understanding">
  <h1 class="font-display text-4xl font-extrabold tracking-tight text-slate-900">Quiz</h1>
  <p class="mt-3 text-lg text-slate-500">Test what stuck. Questions pull from every story.</p>
  <div class="mt-10 max-w-2xl">
    <QuizWidget scope="all" caption="" />
  </div>
</BaseLayout>
