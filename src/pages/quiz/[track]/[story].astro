---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuizWidget from '../../../components/QuizWidget.astro';
import { getTrack } from '../../../lib/tracks';

export async function getStaticPaths() {
  const trackIds = ['concepts', 'evaluation', 'mlops'] as const;
  const paths = [];
  for (const track of trackIds) {
    const entries = await getCollection(track, ({ data }) => !data.draft);
    for (const entry of entries) {
      if (entry.data.quiz && entry.data.quiz.length === 3) {
        paths.push({ params: { track, story: entry.slug }, props: { entry } });
      }
    }
  }
  return paths;
}

const { entry } = Astro.props;
const meta = getTrack(entry.data.track);
---

<BaseLayout title={`Quiz: ${entry.data.title}`} description={`Test what stuck from ${entry.data.title}.`}>
  <p class="text-sm font-medium uppercase tracking-wide text-slate-400">
    {meta.navLabel} · week {entry.data.week}
  </p>
  <h1 class="mt-2 font-display text-4xl font-extrabold tracking-tight text-slate-900">{entry.data.title}</h1>
  <p class="mt-2 text-slate-500">Test what stuck from this story.</p>

  <div class="mt-8 max-w-2xl">
    <QuizWidget questions={entry.data.quiz} heading="story quiz" />
  </div>

  <p class="mt-8 text-sm">
    <a href={`/${entry.data.track}/${entry.slug}`} class="font-medium text-violet-600 hover:underline">
      Re-read the story →
    </a>
  </p>
</BaseLayout>
