---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubscribeForm from '../components/SubscribeForm.astro';

const whyStories = [
  {
    title: 'Context becomes memorable',
    body: 'Stories give meaning to complex ideas.',
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>`,
  },
  {
    title: 'Characters make it relatable',
    body: 'You connect with ideas through people.',
    svg: `<svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6"><path d="M12 2l2.2 6.8L21 11l-6.8 2.2L12 20l-2.2-6.8L3 11l6.8-2.2z"/></svg>`,
  },
  {
    title: 'Understanding that lasts',
    body: 'You remember stories long after the details.',
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.1V17h6v-.2c0-.8.4-1.6 1-2.1A7 7 0 0 0 12 2z"/></svg>`,
  },
];
---

<BaseLayout title="MLStories" description="AI/ML concepts, told as stories." wide={true}>
  <!-- Hero -->
  <section class="relative">
    <div class="relative grid items-center gap-10 py-12 lg:grid-cols-2 lg:py-20">
      <div>
        <span class="inline-flex items-center rounded-full bg-violet-100 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-violet-600">
          Learn AI through stories
        </span>

        <h1 class="mt-5 max-w-xl font-display text-4xl font-extrabold leading-[1.1] tracking-tight text-slate-900 sm:text-5xl">
          Every AI Concept<br />Has a <span class="text-violet-600">Story.</span>
        </h1>

        <p class="mt-6 max-w-md text-lg leading-relaxed text-slate-600">
          Understand Machine Learning, LLMs, evaluation methods, model architecture and AI Governance through stories that are easy to understand and impossible to forget.
        </p>

        <div class="mt-8">
          <a
            href="/stories"
            class="inline-flex items-center gap-2 rounded-xl bg-violet-600 px-6 py-3.5 text-base font-semibold text-white shadow-sm transition hover:bg-violet-700"
          >
            Start Reading
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>
      </div>

      <div class="flex justify-center lg:justify-end">
        <img
          src="/images/mlops/week-02/LandingPageImage.png"
          alt="AI concepts told as stories"
          class="w-full max-w-md lg:max-w-lg"
        />
      </div>
    </div>
  </section>

  <!-- Why stories -->
  <section class="mt-8 rounded-3xl bg-violet-50/70 p-8 sm:p-12">
    <p class="text-xs font-semibold uppercase tracking-wider text-violet-600">Why stories?</p>
    <div class="mt-6 grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-3xl font-extrabold leading-tight tracking-tight text-slate-900">
          We don't just teach concepts.<br />
          <span class="text-violet-600">We make them stick.</span>
        </h2>
        <p class="mt-4 max-w-md leading-relaxed text-slate-600">
          Stories create context. Context creates understanding. Understanding lasts.
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-3">
        {whyStories.map((item) => (
          <div>
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-violet-100 text-violet-600" set:html={item.svg} />
            <h3 class="mt-4 font-display font-bold text-slate-900">{item.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-slate-600">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stay inspired / subscribe -->
  <section class="mt-8 overflow-hidden rounded-3xl bg-gradient-to-br from-violet-50 to-indigo-50 p-8 sm:p-12">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <div class="flex items-start gap-4">
        <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-violet-100 text-violet-600">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
        </span>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-violet-600">Stay inspired</p>
          <h2 class="mt-1 font-display text-2xl font-extrabold tracking-tight text-slate-900">Stories in your inbox.</h2>
          <p class="mt-1 leading-relaxed text-slate-600">
            One thoughtfully written story. Every two weeks.
          </p>
        </div>
      </div>

      <div class="lg:justify-self-end">
        <SubscribeForm />
        <p class="mt-2 text-sm text-slate-500">Join fellow curious minds.</p>
      </div>
    </div>
  </section>
</BaseLayout>
