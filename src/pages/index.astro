---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicCard from '../components/TopicCard.astro';
import StoryCard from '../components/StoryCard.astro';
import QuizWidget from '../components/QuizWidget.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { TRACKS } from '../lib/tracks';

const allEntries = (
  await Promise.all(
    TRACKS.map(async (t) => {
      const entries = await getCollection(t.id, ({ data }) => !data.draft);
      return entries.map((e) => ({ ...e, track: t.id }));
    })
  )
).flat();

const latest = allEntries
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="MLStories"
  description="AI/ML Story Guide"
>
  <section class="py-8 text-center">
    <span class="inline-flex items-center gap-1 rounded-full bg-violet-100 px-3 py-1 text-xs font-medium text-violet-700">
      
    </span>
    <h1 class="mx-auto mt-6 max-w-2xl text-4xl font-bold leading-tight sm:text-5xl">
      
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-slate-600">
      The model has a motive. The data has a flaw.
      Every character you meet keeps you held in awe.
      Beneath every metric, a drama that awaits.
      Read a story and watch as the concept resonates.
    </p>
    <div class="mt-6">
      <SubscribeForm />
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-xs font-medium uppercase tracking-wide text-slate-400">browse by topic</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      {TRACKS.map((t) => (
        <TopicCard
          heading={t.heading}
          description={t.description}
          href={`/${t.id}`}
          icon={t.icon}
          badgeBg={t.badgeBg}
          badgeText={t.badgeText}
        />
      ))}
    </div>
  </section>

  <section class="mt-14">
    <h2 class="text-xs font-medium uppercase tracking-wide text-slate-400">latest stories</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {latest.map((entry) => {
        const minutes = Math.max(1, Math.round(entry.body.split(/\s+/).length / 200));
        return (
          <StoryCard
            title={entry.data.title}
            description={entry.data.description}
            href={`/${entry.track}/${entry.slug}`}
            track={entry.track}
            week={entry.data.week}
            tagline={entry.data.tagline}
            icon={entry.data.icon}
            minutes={minutes}
          />
        );
      })}
      
    </div>
  </section>

  <section class="mt-14">
    <h2 class="text-xs font-medium uppercase tracking-wide text-slate-400">test your knowledge</h2>
    <div class="mt-4">
      <QuizWidget scope="latest" caption="" />
    </div>
  </section>
</BaseLayout>
