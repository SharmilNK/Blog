---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
---

<BaseLayout title="MLStories" description="AI/ML concepts, told as stories." wide={true}>
  <section class="relative overflow-hidden">
    <!-- Geometric square decoration (purple palette) -->
    <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-1/2 lg:block" aria-hidden="true">
      <div class="absolute right-24 top-10 h-28 w-28 rotate-6 rounded-2xl bg-violet-200/70"></div>
      <div class="absolute right-44 top-36 h-24 w-24 -rotate-6 rounded-2xl bg-violet-500/80"></div>
      <div class="absolute right-10 top-44 h-20 w-20 rotate-12 rounded-2xl bg-indigo-300/70"></div>
      <div class="absolute right-56 top-64 h-24 w-24 rotate-3 rounded-2xl bg-purple-300/70"></div>
      <div class="absolute right-28 top-72 h-16 w-16 -rotate-12 rounded-2xl bg-violet-600/80"></div>
    </div>

    <div class="relative grid items-center gap-10 py-12 lg:grid-cols-2 lg:py-20">
      <div>
        <h1 class="max-w-xl font-display text-4xl font-extrabold leading-[1.1] tracking-tight text-slate-900 sm:text-5xl">
          Every AI Concept<br />Has a Story.
        </h1>

        <p class="mt-6 max-w-md text-lg leading-relaxed text-slate-600">
          Understand Machine Learning, LLMs, evaluation methods, model architecture and AI Governance through short stories you'll remember.
        </p>

        <div class="mt-8">
          <a
            href="/stories"
            class="inline-flex items-center gap-2 rounded-xl bg-violet-600 px-6 py-3.5 text-base font-semibold text-white shadow-sm transition hover:bg-violet-700"
          >
            Start Reading
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>

        <div class="mt-10 max-w-md">
          <p class="leading-relaxed text-slate-600">We forget formulas. We remember stories.</p>
          <p class="mt-2 leading-relaxed text-slate-600">
            That's why every lesson introduces characters, conflict and resolution before explaining the underlying AI concept.
          </p>
        </div>
      </div>

      <!-- spacer column for the decoration on large screens -->
      <div class="hidden lg:block"></div>
    </div>

    <!-- Subscribe row, pulled down and centered, just above the form -->
    <div class="mt-24 flex flex-col items-center text-center">
      <p class="text-sm font-medium text-slate-500 sm:whitespace-nowrap">
        Join fellow readers. One AI story. Every two weeks. Only memorable ideas.
      </p>
      <div class="mt-4">
        <SubscribeForm />
      </div>
    </div>
  </section>
</BaseLayout>
