---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';

const entries = (await getCollection('concepts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout title="Concepts" description="Foundational and advanced ML/AI concepts, told as stories.">
  <h1 class="font-serif text-3xl font-bold">ML/AI Concepts</h1>
  <div class="mt-8">
    {entries.map((entry) => (
      <StoryCard
        title={entry.data.title}
        description={entry.data.description}
        href={`/concepts/${entry.slug}`}
        track="concepts"
        week={entry.data.week}
        publishDate={entry.data.publishDate}
      />
    ))}
  </div>
</BaseLayout>
