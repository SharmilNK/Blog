---
import { getCollection, type CollectionEntry } from 'astro:content';
import StoryLayout from '../../layouts/StoryLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('mlops', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'mlops'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<StoryLayout
  title={entry.data.title}
  description={entry.data.description}
  track="mlops"
  slug={entry.slug}
  week={entry.data.week}
  characters={entry.data.characters}
  publishDate={entry.data.publishDate}
  quiz={entry.data.quiz}
>
  <Content />
</StoryLayout>
