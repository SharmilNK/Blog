---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';

const entries = (await getCollection('evaluation', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout title="Evaluation" description="How we measure whether models actually work, told as stories.">
  <h1 class="font-serif text-3xl font-bold">Evaluation</h1>
  <p class="mt-2 text-slate-600">BLEU, ROUGE, RAGAS, LLM-as-judge, human eval — as courtroom dramas, audits, and investigations.</p>
  <div class="mt-8">
    {entries.map((entry) => (
      <StoryCard
        title={entry.data.title}
        description={entry.data.description}
        href={`/evaluation/${entry.slug}`}
        track="evaluation"
        week={entry.data.week}
        publishDate={entry.data.publishDate}
      />
    ))}
  </div>
</BaseLayout>
