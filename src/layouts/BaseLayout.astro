---
import SEO from '../components/SEO.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const nav = [
  { href: '/concepts', label: 'concepts' },
  { href: '/evaluation', label: 'evaluation' },
  { href: '/mlops', label: 'mlops' },
  { href: '/quiz', label: 'quiz' },
  { href: '/about', label: 'about' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title={title} description={description} image={image} />
  </head>
  <body class="min-h-screen bg-stone-50 text-slate-900 antialiased">
    <header class="border-b border-slate-200">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
        <a href="/" class="text-lg font-bold">
          ml<span class="text-violet-600">stories</span>
        </a>
        <nav class="hidden gap-6 text-sm font-medium text-slate-600 sm:flex">
          {nav.map((item) => (
            <a href={item.href} class="hover:text-slate-900">{item.label}</a>
          ))}
        </nav>
        <a
          href="/about#subscribe"
          class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold hover:border-slate-900"
        >
          subscribe free
        </a>
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-10">
      <slot />
    </main>
  </body>
</html>
