---
import BaseLayout from './BaseLayout.astro';
import QuizBlock from '../components/QuizBlock.astro';

interface Props {
  title: string;
  description: string;
  track: 'concepts' | 'evaluation' | 'mlops';
  slug: string;
  week: number;
  characters: string[];
  publishDate: Date;
  quiz: {
    tier: 'basic' | 'intermediate' | 'expert';
    question: string;
    options: string[];
    answer: number;
  }[];
}

const { title, description, track, slug, week, characters, publishDate, quiz } = Astro.props;
const ogImage = `/open-graph/${track}/${slug}.png`;
const trackLabel = { concepts: 'Concepts', evaluation: 'Evaluation', mlops: 'MLOps' }[track];
---

<BaseLayout title={title} description={description} image={ogImage}>
  <article>
    <p class="text-sm font-medium uppercase tracking-wide text-slate-500">
      {trackLabel} · Week {week}
    </p>
    <h1 class="mt-2 font-serif text-4xl font-bold">{title}</h1>
    <p class="mt-3 text-sm text-slate-500">
      {publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      · Characters: {characters.join(', ')}
    </p>

    <div class="prose-story mt-8">
      <slot />
    </div>

    <hr class="my-10 border-slate-200" />

    <QuizBlock quiz={quiz} />
  </article>
</BaseLayout>

<script>
  // Mermaid diagrams are authored directly in story markdown as fenced
  // ```mermaid blocks; rendered client-side so the build stays static.
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

  const blocks = document.querySelectorAll('pre > code.language-mermaid');
  blocks.forEach((block, i) => {
    const pre = block.parentElement;
    const container = document.createElement('div');
    container.className = 'mermaid';
    container.id = `mermaid-${i}`;
    container.textContent = block.textContent ?? '';
    pre?.replaceWith(container);
  });

  if (blocks.length > 0) {
    mermaid.initialize({ startOnLoad: true, theme: 'neutral' });
  }
</script>
