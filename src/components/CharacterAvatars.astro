---
interface Props {
  characters: string[];
}

const { characters } = Astro.props;
const palette = ['#7c3aed', '#10b981', '#f59e0b', '#ef4444', '#06b6d4'];
const faces = characters.slice(0, 3).map((name, i) => ({
  initial: name.trim().charAt(0).toUpperCase(),
  color: palette[i % palette.length],
}));
---

<div class="flex justify-center gap-5 py-8">
  {faces.map((f) => (
    <div
      class="flex h-20 w-20 items-center justify-center rounded-full text-2xl font-bold text-white shadow-sm"
      style={`background:${f.color}`}
    >
      {f.initial}
    </div>
  ))}
</div>
