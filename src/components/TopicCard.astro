---
interface Props {
  title: string;
  description: string;
  href: string;
  count: number;
}

const { title, description, href, count } = Astro.props;
---

<a href={href} class="block rounded-lg border border-slate-200 p-6 transition hover:border-slate-400">
  <h3 class="font-serif text-xl font-bold">{title}</h3>
  <p class="mt-2 text-sm text-slate-600">{description}</p>
  <p class="mt-4 text-xs uppercase tracking-wide text-slate-400">{count} stories</p>
</a>
