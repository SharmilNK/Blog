---
interface Props {
  heading: string;
  description: string;
  href: string;
  icon: string;
  badgeBg: string;
  badgeText: string;
  active?: boolean;
}

const { heading, description, href, icon, badgeBg, badgeText, active = false } = Astro.props;
---

<a
  href={href}
  class:list={[
    'block rounded-xl border bg-white p-5 transition hover:border-slate-400',
    active ? 'border-violet-400 ring-1 ring-violet-200' : 'border-slate-200',
  ]}
>
  <span class:list={['inline-flex h-9 w-9 items-center justify-center rounded-lg text-lg', badgeBg, badgeText]}>
    {icon}
  </span>
  <h3 class="mt-3 font-bold">{heading}</h3>
  <p class="mt-1 text-sm text-slate-600">{description}</p>
</a>
