---
interface QuizQuestion {
  tier: 'basic' | 'intermediate' | 'expert';
  question: string;
  options: string[];
  answer: number;
}

interface Props {
  questions: QuizQuestion[];
  heading?: string;
  caption?: string;
  id?: string;
}

const { questions, heading = 'story quiz', caption, id = 'quiz' } = Astro.props;
const instanceId = id;

const tiers = ['basic', 'intermediate', 'expert'] as const;
const questionByTier = Object.fromEntries(
  tiers.map((tier) => [tier, questions.find((q) => q.tier === tier)])
);
---

<section class="rounded-xl border border-slate-200 bg-stone-100 p-6" data-quiz={instanceId}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="flex items-center gap-2 font-medium">
      <span>🏆</span> {heading}
    </p>
    <div class="flex gap-2">
      {tiers.map((tier, i) => (
        <button
          type="button"
          class:list={['tier-btn rounded-md border px-3 py-1 text-xs font-medium', i === 0 ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-300 text-slate-600']}
          data-tier-btn={tier}
        >
          {tier}
        </button>
      ))}
    </div>
  </div>

  <div class="mt-4">
    {tiers.map((tier, i) => {
      const q = questionByTier[tier];
      if (!q) return null;
      return (
        <div class="tier-panel rounded-lg border border-slate-200 bg-white p-4" data-tier-panel={tier} hidden={i !== 0}>
          <p class="font-medium">{q.question}</p>
          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            {q.options.map((option, oi) => (
              <button
                type="button"
                class="quiz-option rounded border border-slate-200 px-3 py-2 text-left text-sm hover:bg-slate-50"
                data-correct={oi === q.answer ? 'true' : 'false'}
                data-group={`${instanceId}-${tier}`}
              >
                {option}
              </button>
            ))}
          </div>
        </div>
      );
    })}
  </div>

  <p class="mt-4 flex justify-between text-xs text-slate-500">
    <span>score: <span class="quiz-score">0</span>/<span class="quiz-total">0</span></span>
    {caption && <span>{caption}</span>}
  </p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((widget) => {
    const tierButtons = widget.querySelectorAll<HTMLButtonElement>('.tier-btn');
    const panels = widget.querySelectorAll<HTMLElement>('.tier-panel');
    const scoreEl = widget.querySelector('.quiz-score');
    const totalEl = widget.querySelector('.quiz-total');
    let correct = 0;
    let total = 0;

    tierButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tier = btn.dataset.tierBtn;
        panels.forEach((p) => {
          p.hidden = p.dataset.tierPanel !== tier;
        });
        tierButtons.forEach((b) => {
          const isActive = b === btn;
          b.classList.toggle('border-slate-900', isActive);
          b.classList.toggle('bg-slate-900', isActive);
          b.classList.toggle('text-white', isActive);
          b.classList.toggle('border-slate-300', !isActive);
          b.classList.toggle('text-slate-600', !isActive);
        });
      });
    });

    widget.querySelectorAll<HTMLButtonElement>('.quiz-option').forEach((option) => {
      option.addEventListener('click', () => {
        if (option.disabled) return;
        const group = option.dataset.group;
        const siblings = widget.querySelectorAll<HTMLButtonElement>(`.quiz-option[data-group="${group}"]`);
        total += 1;
        if (option.dataset.correct === 'true') correct += 1;
        siblings.forEach((sib) => {
          sib.disabled = true;
          if (sib.dataset.correct === 'true') sib.classList.add('border-green-500', 'bg-green-50');
          else if (sib === option) sib.classList.add('border-red-500', 'bg-red-50');
        });
        if (scoreEl) scoreEl.textContent = String(correct);
        if (totalEl) totalEl.textContent = String(total);
      });
    });
  });
</script>
