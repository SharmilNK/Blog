---
import { getTrack, type TrackId } from '../lib/tracks';

interface Props {
  title: string;
  description: string;
  href: string;
  track: TrackId;
  week: number;
  tagline: string;
  icon: string;
  minutes: number;
}

const { title, description, href, track, week, tagline, icon, minutes } = Astro.props;
const meta = getTrack(track);
---

<a href={href} class="block overflow-hidden rounded-2xl border border-slate-200 bg-white transition hover:border-violet-300 hover:shadow-lg hover:shadow-violet-100">
  <div class:list={['relative flex h-28 items-center justify-center bg-gradient-to-br', meta.cardGradient]}>
    <span class="text-3xl">{icon}</span>
  </div>
  <div class="p-5">
    <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
      {meta.navLabel} · week {week}
    </p>
    <h3 class="mt-1 font-display font-bold leading-snug text-slate-900">{title}</h3>
    <p class="mt-1.5 text-sm leading-relaxed text-slate-600 whitespace-pre-line">{description}</p>
    <div class="mt-4 flex items-center justify-between text-xs text-slate-500">
      <span>⏱ {minutes} min read</span>
      <span class="font-semibold text-violet-600">read story →</span>
    </div>
  </div>
</a>
