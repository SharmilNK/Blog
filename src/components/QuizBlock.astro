---
interface QuizQuestion {
  tier: 'basic' | 'intermediate' | 'expert';
  question: string;
  options: string[];
  answer: number;
}

interface Props {
  quiz: QuizQuestion[];
}

const { quiz } = Astro.props;
const tierLabel = { basic: 'Basic', intermediate: 'Intermediate', expert: 'Expert' };
---

<section aria-labelledby="quiz-heading">
  <h2 id="quiz-heading" class="font-serif text-2xl font-bold">Quiz</h2>
  <p class="mt-1 text-sm text-slate-500">Check your understanding at three levels.</p>

  <ol class="mt-6 space-y-6">
    {quiz.map((q, qi) => (
      <li class="rounded-lg border border-slate-200 p-5">
        <p class="text-xs font-medium uppercase tracking-wide text-slate-500">{tierLabel[q.tier]}</p>
        <p class="mt-1 font-medium">{q.question}</p>
        <ul class="mt-3 space-y-2">
          {q.options.map((option, oi) => (
            <li>
              <button
                type="button"
                class="quiz-option w-full rounded border border-slate-200 px-3 py-2 text-left text-sm hover:bg-slate-50"
                data-correct={oi === q.answer ? 'true' : 'false'}
                data-group={`q-${qi}`}
              >
                {option}
              </button>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</section>

<script>
  // Self-contained reveal-on-click scoring. No answers are sent anywhere —
  // this is intentionally local-only for now.
  document.querySelectorAll<HTMLButtonElement>('.quiz-option').forEach((button) => {
    button.addEventListener('click', () => {
      const group = button.dataset.group;
      const siblings = document.querySelectorAll<HTMLButtonElement>(
        `.quiz-option[data-group="${group}"]`
      );
      siblings.forEach((sib) => {
        sib.disabled = true;
        if (sib.dataset.correct === 'true') {
          sib.classList.add('border-green-500', 'bg-green-50');
        } else if (sib === button) {
          sib.classList.add('border-red-500', 'bg-red-50');
        }
      });
    });
  });
</script>
