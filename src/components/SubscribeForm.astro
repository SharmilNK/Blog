---
interface Props {
  buttonLabel?: string;
}
const { buttonLabel = 'get stories' } = Astro.props;
---

<!--
  Placeholder UI only — not wired to Beehiiv yet. Point the form's `action`
  at your Beehiiv embed endpoint once you have a publication set up, or
  swap this for Beehiiv's own embed snippet.
-->
<form class="flex justify-center gap-2" data-subscribe-form>
  <input
    type="email"
    required
    placeholder="your@email.com"
    class="w-64 rounded-md border border-slate-300 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-violet-400"
  />
  <button
    type="submit"
    class="rounded-md border border-slate-900 bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
  >
    {buttonLabel}
  </button>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-subscribe-form]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Subscriptions aren\'t wired up yet — connect this form to Beehiiv.');
    });
  });
</script>
