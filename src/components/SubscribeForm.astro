---
// Beehiiv subscribe form embed. Beehiiv's loader.js injects the hosted
// subscribe form (styled in the Beehiiv form builder) wherever this renders.
// `is:inline` keeps Astro from bundling/altering the third-party script so the
// `data-beehiiv-form` id and `async` attribute survive verbatim.
---

<div class="beehiiv-embed w-full max-w-md text-left">
  <script
    is:inline
    async
    src="https://subscribe-forms.beehiiv.com/v3/loader.js"
    data-beehiiv-form="036a14ee-c795-49fa-a987-0921eb51e5bf"
  ></script>
</div>

<style is:global>
  /* Left-align Beehiiv's embedded form instead of letting it auto-center. */
  .beehiiv-embed iframe {
    margin-left: 0 !important;
    max-width: 100% !important;
  }
</style>
